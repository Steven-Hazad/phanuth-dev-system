// This is your Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  title     String
  tagline   String
  bioKh     String   @db.Text
  bioEn     String   @db.Text
  gpa       Float
}

model Education {
  id           Int      @id @default(autoincrement())
  degree       String
  university   String
  startDate    DateTime
  endDate      DateTime?
  gpa          Float
  achievements String   @db.Text
}
model Project {
  id           Int      @id @default(autoincrement())
  title        String
  category     String   // e.g., "Web System", "Mobile App"
  description  String   @db.Text
  techStack    String   // e.g., "Next.js, MySQL, Tailwind"
  githubUrl    String?
  demoUrl      String?
  status       String   @default("Completed") // or "In Progress"
  createdAt    DateTime @default(now())
}

// We'll also add a Skill table for later
model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  level     Int     // 1 to 100
  category  String  // e.g., "Frontend", "Backend", "Database"
}